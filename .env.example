# Used by docker-compose.yml. Copy to .env (never commit it).

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where the browser reaches the API (baked into the frontend build).
API_PUBLIC_URL=http://localhost:8000

# Optional: file uploads (leave empty to disable attachments)
CLOUDINARY_CLOUDNAME=
CLOUDINARY_APIKEY=
CLOUDINARY_API_SECRET=
