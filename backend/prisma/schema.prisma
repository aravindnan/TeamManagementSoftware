// PostgreSQL schema for the Team Management API.
//
// Ids are 24-character hex strings in the MongoDB ObjectId format, generated by the application
// (see db/objectId.js). They sort by creation time, so cursor pagination over `id` keeps working,
// and ids that existed before the move from MongoDB are preserved as they are.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  owner
  admin
  member
}

enum InviteRole {
  admin
  member
}

enum ActivityCategory {
  project
  task
  comment
  file
  member
}

model User {
  id                String    @id @db.VarChar(24)
  username          String    @unique
  email             String    @unique // stored lower-case
  password          String // bcrypt hash; never returned by the API
  googleId          String?   @unique // Google "sub"; NULLs do not collide
  emailVerified     Boolean   @default(false)
  tokenVersion      Int       @default(0) // bumped to revoke every issued token
  firstName         String
  lastName          String    @default("")
  role              String?
  dateOfBirth       String?
  lastLoginDate     DateTime?
  profilePictureURL String    @default("")
  bio               String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  managedProjects  Project[]       @relation("ProjectManager")
  projectMembers   ProjectMember[]
  assignedTasks    Task[]          @relation("TaskAssignee")
  createdTasks     Task[]          @relation("TaskCreator")
  ownedWorkspaces  Workspace[]     @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  notifications    Notification[]
  comments         Comment[]
  activities       Activity[]
  media            Media[]
  invitesSent      Invite[]        @relation("InviteSender")
  invitesAccepted  Invite[]        @relation("InviteAcceptor")
}

model Workspace {
  id        String   @id @db.VarChar(24)
  name      String
  ownerId   String   @db.VarChar(24)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // An account that owns a workspace cannot be deleted until ownership moves (the API checks first).
  owner    User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members  WorkspaceMember[]
  projects Project[]
  invites  Invite[]

  @@index([ownerId])
}

model WorkspaceMember {
  workspaceId String        @db.VarChar(24)
  userId      String        @db.VarChar(24)
  role        WorkspaceRole @default(member)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id           String     @id @db.VarChar(24)
  workspaceId  String     @db.VarChar(24)
  email        String // lower-case
  role         InviteRole @default(member)
  // Only a hash of the secret link token is stored, so a database leak does not leak working invites.
  tokenHash    String     @unique
  invitedById  String?    @db.VarChar(24)
  createdAt    DateTime   @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?    @db.VarChar(24)
  revokedAt    DateTime?

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?     @relation("InviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([email, acceptedAt, revokedAt])
}

model Project {
  id                 String   @id @db.VarChar(24)
  projectName        String
  projectDescription String   @default("")
  // Optional: projects created before workspaces existed have none.
  workspaceId        String?  @db.VarChar(24)
  projectManagerId   String   @db.VarChar(24)
  startDate          DateTime @default(now())
  projectStatus      String   @default("In Progress") // "In Progress" | "Completed"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  manager   User              @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: Restrict)
  members   ProjectMember[]
  tasks     Task[]
  comments  Comment[]
  media     Media[]
  activity  Activity[]
  notifications Notification[]

  @@index([workspaceId])
  @@index([projectManagerId])
}

// The manager is a row here too, exactly as they were in the old `projectMembers` array.
model ProjectMember {
  projectId String   @db.VarChar(24)
  userId    String   @db.VarChar(24)
  addedAt   DateTime @default(now()) // keeps the member list in the order people joined

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id              String    @id @db.VarChar(24)
  taskTitle       String
  taskDescription String    @default("")
  taskPriority    String    @default("Medium") // High | Medium | Low
  projectId       String    @db.VarChar(24)
  assignedById    String?   @db.VarChar(24) // null once the creator's account is deleted
  assignedToId    String    @db.VarChar(24)
  taskStatus      String    @default("To Do") // see utils/constants.js
  // Set automatically when a task enters/leaves "Completed"; feeds cycle-time statistics.
  completedAt     DateTime?
  // Kept as strings for compatibility with the existing UI date handling.
  dueDate         String?
  assignedOn      String?
  labels          String[]  @default([])
  estimateHours   Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedBy User?     @relation("TaskCreator", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedTo User      @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  subtasks   Subtask[]
  comments   Comment[]
  media      Media[]

  @@index([projectId, taskStatus])
  @@index([assignedToId, taskStatus])
  @@index([assignedById])
}

model Subtask {
  id          String    @id @db.VarChar(24)
  taskId      String    @db.VarChar(24)
  title       String
  done        Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// A comment belongs to exactly one project or one task.
model Comment {
  id             String   @id @db.VarChar(24)
  senderName     String
  messageContent String
  senderId       String?  @db.VarChar(24) // null once the author's account is deleted
  timeStamp      DateTime @default(now())
  projectId      String?  @db.VarChar(24)
  taskId         String?  @db.VarChar(24)

  sender  User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
}

// A file attached to a project or to a task.
model Media {
  id         String  @id @db.VarChar(24)
  mediaType  String?
  mediaURL   String
  mediaName  String?
  mediaSize  Float?
  uploadedBy String? @db.VarChar(24)
  projectId  String? @db.VarChar(24)
  taskId     String? @db.VarChar(24)

  uploader User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
}

// Append-only log of what happened in a project. Names/titles are snapshotted into `data`
// so entries stay readable after the task, comment or user they describe is gone.
model Activity {
  id         String           @id @db.VarChar(24)
  projectId  String           @db.VarChar(24)
  actorId    String?          @db.VarChar(24)
  actorName  String           @default("Someone")
  verb       String
  category   ActivityCategory
  // Plain id, no foreign key: the task may since have been deleted.
  taskId     String?          @db.VarChar(24)
  data       Json             @default("{}")
  createdAt  DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // Feed queries: newest first, optionally narrowed to one category or task, paged by id.
  @@index([projectId, id(sort: Desc)])
  @@index([projectId, category, id(sort: Desc)])
  @@index([projectId, taskId, id(sort: Desc)])
}

// One row per recipient. Text parts are snapshotted so a notification still reads correctly
// after the task or project it mentions is gone.
model Notification {
  id          String    @id @db.VarChar(24)
  userId      String    @db.VarChar(24)
  type        String // same vocabulary as Activity.verb
  actorName   String    @default("Someone")
  projectId   String?   @db.VarChar(24)
  projectName String?
  taskId      String?   @db.VarChar(24)
  data        Json      @default("{}")
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, id(sort: Desc)])
  @@index([userId, readAt, id(sort: Desc)])
  @@index([projectId])
}
