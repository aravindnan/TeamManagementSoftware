# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=8000

# Either provide a full connection string...
# MONGO_URI=mongodb+srv://user:pass@host/dbname
# ...or the individual parts:
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# DB_HOST=cluster0.example.mongodb.net

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed browser origins
CLIENT_ORIGINS=http://localhost:3000
# lax (same-site) | none (cross-site, requires HTTPS)
COOKIE_SAMESITE=lax
# Defaults to true in production (HTTPS). Set false only for plain-HTTP local runs.
# COOKIE_SECURE=false

# Google sign-in. Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# and add your web app's origin (e.g. http://localhost:3000) under "Authorized JavaScript origins".
# Leave empty to disable the Google buttons.
GOOGLE_CLIENT_ID=

# Base URL used in invite links (defaults to the first CLIENT_ORIGINS entry)
# PUBLIC_CLIENT_URL=http://localhost:3000

# Cloudinary (server-side only; used to sign uploads)
CLOUDINARY_CLOUDNAME=
CLOUDINARY_APIKEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tms
